{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.ocrs.dev/v0.1/schemas/readiness-review.schema.json",
  "title": "Readiness Review",
  "allOf": [
    { "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json" },
    {
      "type": "object",
      "required": [
        "entityType",
        "gateId",
        "subjectIds",
        "boundaryIds",
        "reviewedAt",
        "reviewerRoleAssignmentIds",
        "evidenceIds",
        "evaluationId",
        "conclusion",
        "rationale"
      ],
      "properties": {
        "entityType": { "const": "readiness-review" },
        "gateId": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "subjectIds": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/idArray"
        },
        "boundaryIds": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/idArray"
        },
        "reviewedAt": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/timestamp"
        },
        "reviewerRoleAssignmentIds": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/idArray"
        },
        "evidenceIds": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/idArray"
        },
        "evaluationId": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "conclusion": {
          "enum": ["supports_proceed", "supports_proceed_with_conditions", "does_not_support"]
        },
        "rationale": { "type": "string", "minLength": 1 },
        "openDeficiencyIds": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/idArray"
        },
        "constraintIds": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/idArray"
        },
        "dependencyIds": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/idArray"
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
