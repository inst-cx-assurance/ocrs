{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.ocrs.dev/v0.1/schemas/transfer-of-operational-control.schema.json",
  "title": "Transfer of Operational Control record",
  "allOf": [
    { "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json" },
    {
      "type": "object",
      "required": [
        "entityType",
        "systemIds",
        "boundaryIds",
        "readinessDecisionId",
        "handoverId",
        "supportBasisType",
        "fromPartyId",
        "toPartyId",
        "transferredByRoleAssignmentId",
        "acceptedByRoleAssignmentId",
        "effectiveAt",
        "status"
      ],
      "properties": {
        "entityType": { "const": "transfer-of-operational-control" },
        "systemIds": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/idArray"
        },
        "boundaryIds": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/idArray"
        },
        "readinessDecisionId": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "handoverId": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "supportBasisType": { "enum": ["aocr_decision", "profile_approved_equivalent"] },
        "approvedEquivalentProfileId": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "fromPartyId": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "toPartyId": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "transferredByRoleAssignmentId": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "acceptedByRoleAssignmentId": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "effectiveAt": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/timestamp"
        },
        "status": { "enum": ["proposed", "effective", "revoked", "superseded"] }
      }
    }
  ],
  "unevaluatedProperties": false
}
