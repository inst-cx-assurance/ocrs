{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.ocrs.dev/v0.1/schemas/role-assignment.schema.json",
  "title": "Level 2 role assignment",
  "allOf": [
    { "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json" },
    {
      "type": "object",
      "required": ["entityType", "partyId", "role", "authorityScopeId", "validFrom"],
      "properties": {
        "entityType": { "const": "role-assignment" },
        "partyId": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "role": {
          "enum": [
            "execution_evidence_owner",
            "readiness_reviewer",
            "readiness_decision_authority",
            "delivery_party",
            "receiving_organization",
            "deficiency_owner"
          ]
        },
        "authorityScopeId": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "validFrom": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/timestamp"
        },
        "validTo": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/timestamp"
        },
        "competenceBasis": { "type": "string" },
        "delegationBasis": { "type": "string" }
      }
    }
  ],
  "unevaluatedProperties": false
}
