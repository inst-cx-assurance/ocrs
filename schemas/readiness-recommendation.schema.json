{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.ocrs.dev/v0.1/schemas/readiness-recommendation.schema.json",
  "title": "Readiness Recommendation",
  "allOf": [
    { "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json" },
    {
      "type": "object",
      "required": [
        "entityType",
        "reviewId",
        "gateId",
        "issuedByRoleAssignmentId",
        "recommendation",
        "issuedAt",
        "rationale",
        "conditionIds"
      ],
      "properties": {
        "entityType": { "const": "readiness-recommendation" },
        "reviewId": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "gateId": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "issuedByRoleAssignmentId": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "recommendation": {
          "enum": [
            "proceed",
            "proceed_with_documented_conditions",
            "not_supported_pending_corrective_action"
          ]
        },
        "issuedAt": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/timestamp"
        },
        "rationale": { "type": "string", "minLength": 1 },
        "conditionIds": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/idArray"
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
