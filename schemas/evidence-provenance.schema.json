{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.ocrs.dev/v0.1/schemas/evidence-provenance.schema.json",
  "title": "Evidence provenance",
  "allOf": [
    { "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json" },
    {
      "type": "object",
      "required": [
        "entityType",
        "evidenceIds",
        "sourcePartyId",
        "sourceSystem",
        "captureMethod",
        "capturedAt",
        "chainOfCustody"
      ],
      "properties": {
        "entityType": { "const": "evidence-provenance" },
        "evidenceIds": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/idArray"
        },
        "sourcePartyId": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/id"
        },
        "sourceSystem": { "type": "string", "minLength": 1 },
        "captureMethod": { "type": "string", "minLength": 1 },
        "capturedAt": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/timestamp"
        },
        "chainOfCustody": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    }
  ],
  "unevaluatedProperties": false
}
