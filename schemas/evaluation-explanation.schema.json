{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://spec.ocrs.dev/v0.1/schemas/evaluation-explanation.schema.json", "title": "Evaluation explanation tree",
  "allOf": [{ "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json" }, { "type": "object", "required": ["entityType", "root"], "properties": { "entityType": { "const": "evaluation-explanation" }, "root": { "$ref": "#/$defs/node" } } }],
  "$defs": { "node": { "type": "object", "required": ["id", "result", "rule", "supportingRecordIds", "children"], "properties": { "id": { "type": "string", "minLength": 1 }, "result": { "enum": ["satisfied", "not_satisfied", "indeterminate"] }, "rule": { "type": "string", "minLength": 1 }, "message": { "type": "string" }, "supportingRecordIds": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/idArray" }, "children": { "type": "array", "items": { "$ref": "#/$defs/node" } } }, "additionalProperties": false } }, "unevaluatedProperties": false
}
