{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.ocrs.dev/v0.1/schemas/ocrs-package.schema.json",
  "title": "OCRS v0.1 package",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "manifest",
    "project",
    "sbs",
    "systems",
    "systemRelationships",
    "assets",
    "interfaces",
    "boundaries",
    "parties",
    "roleAssignments",
    "authorityScopes",
    "executionRequirements",
    "readinessConditions",
    "activities",
    "evidence",
    "evidenceProvenance",
    "evidenceRevisions",
    "deficiencies",
    "deficiencyReclassifications",
    "constraints",
    "dependencies",
    "residualRiskInputs",
    "deterministicEvaluations",
    "evaluationExplanations",
    "commissioningStageGates",
    "operationalReadinessGates",
    "readinessReviews",
    "readinessRecommendations",
    "readinessDecisions",
    "systemHandovers",
    "transfersOfOperationalControl",
    "conditions",
    "changeRecords",
    "profileDeclarations",
    "extensionDeclarations"
  ],
  "properties": {
    "$schema": { "const": "https://spec.ocrs.dev/v0.1/schemas/ocrs-package.schema.json" },
    "schemaVersion": {
      "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/version"
    },
    "manifest": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/package-manifest.schema.json" },
    "project": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/project.schema.json" },
    "sbs": { "$ref": "#/$defs/sbs" },
    "systems": { "$ref": "#/$defs/systems" },
    "systemRelationships": { "$ref": "#/$defs/systemRelationships" },
    "assets": { "$ref": "#/$defs/assets" },
    "interfaces": { "$ref": "#/$defs/interfaces" },
    "boundaries": { "$ref": "#/$defs/boundaries" },
    "parties": { "$ref": "#/$defs/parties" },
    "roleAssignments": { "$ref": "#/$defs/roleAssignments" },
    "authorityScopes": { "$ref": "#/$defs/authorityScopes" },
    "executionRequirements": { "$ref": "#/$defs/executionRequirements" },
    "readinessConditions": { "$ref": "#/$defs/readinessConditions" },
    "activities": { "$ref": "#/$defs/activities" },
    "evidence": { "$ref": "#/$defs/evidence" },
    "evidenceProvenance": { "$ref": "#/$defs/evidenceProvenance" },
    "evidenceRevisions": { "$ref": "#/$defs/evidenceRevisions" },
    "deficiencies": { "$ref": "#/$defs/deficiencies" },
    "deficiencyReclassifications": { "$ref": "#/$defs/deficiencyReclassifications" },
    "constraints": { "$ref": "#/$defs/constraints" },
    "dependencies": { "$ref": "#/$defs/dependencies" },
    "residualRiskInputs": { "$ref": "#/$defs/residualRiskInputs" },
    "deterministicEvaluations": { "$ref": "#/$defs/deterministicEvaluations" },
    "evaluationExplanations": { "$ref": "#/$defs/evaluationExplanations" },
    "commissioningStageGates": { "$ref": "#/$defs/commissioningStageGates" },
    "operationalReadinessGates": { "$ref": "#/$defs/operationalReadinessGates" },
    "readinessReviews": { "$ref": "#/$defs/readinessReviews" },
    "readinessRecommendations": { "$ref": "#/$defs/readinessRecommendations" },
    "readinessDecisions": { "$ref": "#/$defs/readinessDecisions" },
    "systemHandovers": { "$ref": "#/$defs/systemHandovers" },
    "transfersOfOperationalControl": { "$ref": "#/$defs/transfersOfOperationalControl" },
    "conditions": { "$ref": "#/$defs/conditions" },
    "changeRecords": { "$ref": "#/$defs/changeRecords" },
    "profileDeclarations": { "$ref": "#/$defs/profileDeclarations" },
    "extensionDeclarations": { "$ref": "#/$defs/extensionDeclarations" }
  },
  "$defs": {
    "sbs": {
      "type": "array",
      "items": {
        "$ref": "https://spec.ocrs.dev/v0.1/schemas/system-breakdown-structure.schema.json"
      }
    },
    "systems": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/system.schema.json" }
    },
    "systemRelationships": {
      "type": "array",
      "items": {
        "$ref": "https://spec.ocrs.dev/v0.1/schemas/hierarchical-system-relationship.schema.json"
      }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/asset.schema.json" }
    },
    "interfaces": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/interface.schema.json" }
    },
    "boundaries": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/boundary.schema.json" }
    },
    "parties": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/party.schema.json" }
    },
    "roleAssignments": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/role-assignment.schema.json" }
    },
    "authorityScopes": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/authority-scope.schema.json" }
    },
    "executionRequirements": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/execution-requirement.schema.json" }
    },
    "readinessConditions": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/readiness-condition.schema.json" }
    },
    "activities": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/activity.schema.json" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/evidence.schema.json" }
    },
    "evidenceProvenance": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/evidence-provenance.schema.json" }
    },
    "evidenceRevisions": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/evidence-revision.schema.json" }
    },
    "deficiencies": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/deficiency.schema.json" }
    },
    "deficiencyReclassifications": {
      "type": "array",
      "items": {
        "$ref": "https://spec.ocrs.dev/v0.1/schemas/deficiency-reclassification.schema.json"
      }
    },
    "constraints": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/constraint.schema.json" }
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/dependency.schema.json" }
    },
    "residualRiskInputs": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/residual-risk-input.schema.json" }
    },
    "deterministicEvaluations": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/deterministic-evaluation.schema.json" }
    },
    "evaluationExplanations": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/evaluation-explanation.schema.json" }
    },
    "commissioningStageGates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/commissioning-stage-gate.schema.json" }
    },
    "operationalReadinessGates": {
      "type": "array",
      "items": {
        "$ref": "https://spec.ocrs.dev/v0.1/schemas/operational-readiness-gate.schema.json"
      }
    },
    "readinessReviews": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/readiness-review.schema.json" }
    },
    "readinessRecommendations": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/readiness-recommendation.schema.json" }
    },
    "readinessDecisions": {
      "type": "array",
      "items": {
        "$ref": "https://spec.ocrs.dev/v0.1/schemas/readiness-decision-record.schema.json"
      }
    },
    "systemHandovers": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/system-handover.schema.json" }
    },
    "transfersOfOperationalControl": {
      "type": "array",
      "items": {
        "$ref": "https://spec.ocrs.dev/v0.1/schemas/transfer-of-operational-control.schema.json"
      }
    },
    "conditions": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/condition.schema.json" }
    },
    "changeRecords": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/change-record.schema.json" }
    },
    "profileDeclarations": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/profile-declaration.schema.json" }
    },
    "extensionDeclarations": {
      "type": "array",
      "items": { "$ref": "https://spec.ocrs.dev/v0.1/schemas/extension-declaration.schema.json" }
    }
  },
  "additionalProperties": false
}
