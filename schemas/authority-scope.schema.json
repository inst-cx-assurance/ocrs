{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.ocrs.dev/v0.1/schemas/authority-scope.schema.json",
  "title": "Level 2 authority scope",
  "allOf": [
    { "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json" },
    {
      "type": "object",
      "required": ["entityType", "name", "subjectIds", "boundaryIds", "permittedActions"],
      "properties": {
        "entityType": { "const": "authority-scope" },
        "name": { "type": "string", "minLength": 1 },
        "subjectIds": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/idArray"
        },
        "boundaryIds": {
          "$ref": "https://spec.ocrs.dev/v0.1/schemas/base-record.schema.json#/$defs/idArray"
        },
        "permittedActions": {
          "type": "array",
          "items": {
            "enum": [
              "create_evidence",
              "review_readiness",
              "recommend_progression",
              "make_readiness_decision",
              "accept_handover",
              "transfer_operational_control"
            ]
          },
          "uniqueItems": true
        }
      }
    }
  ],
  "unevaluatedProperties": false
}
